# URL de base de ton API backend (sans slash final)
REACT_APP_API_URL=http://localhost:4443/api

# true (ou absent) tant qu'aucun backend n'est branché : login/register
# renvoient des données simulées avec un léger délai. Passe à false une
# fois l'API prête — aucun autre fichier n'a besoin de changer.
REACT_APP_USE_MOCKS=true
