{
  "name": "backend",
  "version": "1.0.0",
  "description": "\"back_end NodeJS/Typescript\"",
  "license": "ISC",
  "author": "mchanlia/khalidkaf",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "dotenv -e .env -- npx prisma generate --schema=./src/prisma/schema.prisma && tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "db:migrate:prod": "dotenv -e .env -- npx prisma migrate deploy",
    "db:studio": "dotenv -e .env -- npx prisma studio --schema=./src/prisma/schema.prisma",
    "db:migrate": "dotenv -e .env -- npx prisma migrate dev --schema=./src/prisma/schema.prisma",
    "db:reset": "dotenv -e .env -- npx prisma migrate reset --force --schema=./src/prisma/schema.prisma",
    "db:adjust": "dotenv -e .env -- npx prisma db push --schema=./src/prisma/schema.prisma",
    "db:generate": "dotenv -e .env -- npx prisma generate --schema=./src/prisma/schema.prisma",
    "db:populate": "tsx src/prisma/seed.ts",
    "db:resetPopulate": "dotenv -e .env npm run db:reset -- -y && npm run db:populate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/jsonwebtoken": "^9.0.10",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "http-errors": "^2.0.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.5",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  }
}
