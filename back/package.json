{
  "name": "backend",
  "version": "1.0.0",
  "description": "\"back_end NodeJS/Typescript\"",
  "license": "ISC",
  "author": "mchanlia/khalidkaf",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently \"tsc -w\" \"node --watch dist/index.js\"",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate:prod": "dotenv -e .env -- npx prisma migrate deploy",
    "db:studio": "dotenv -e .env -- npx prisma studio --schema=./src/prisma/schema.prisma",
    "db:migrate": "dotenv -e .env -- npx prisma migrate dev --schema=./src/prisma/schema.prisma",
    "db:reset": "dotenv -e .env -- npx prisma migrate reset --schema=./src/prisma/schema.prisma",
    "db:adjust": "dotenv -e .env -- npx prisma db push --schema=./src/prisma/schema.prisma",
    "db:generate": "dotenv -e .env -- npx prisma generate --schema=./src/prisma/schema.prisma",
    "db:populate": "dotenv -e .env -- tsx src/prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "http-errors": "^2.0.1",
    "multer": "^2.2.0"
	
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.5",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "concurrently": "^10.0.4",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  }
}
