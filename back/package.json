{
  "name": "backend",
  "version": "1.0.0",
  "description": "\"back_end NodeJS/Typescript\"",
  "license": "ISC",
  "author": "mchanlia/khalidkaf",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently \"tsc -w\" \"node --watch dist/index.js\"",
    "build": "tsc",
    "start": "node dist/index.js",

	"db:migrate:prod": "DATABASE_URL=\"postgresql://GoodCorner:$(cat ../.secrets/password.txt)@localhost:5432/mydb?schema=public\" npx prisma migrate deploy",
    "db:studio": "DATABASE_URL=\"postgresql://GoodCorner:$(cat ../.secrets/password.txt)@localhost:5432/mydb?schema=public\" npx prisma studio --schema=./src/prisma/schema.prisma",
    "db:migrate": "DATABASE_URL=\"postgresql://GoodCorner:$(cat ../.secrets/password.txt)@localhost:5432/mydb?schema=public\" npx prisma migrate dev --schema=./src/prisma/schema.prisma",
    "db:reset": "DATABASE_URL=\"postgresql://GoodCorner:$(cat ../.secrets/password.txt)@localhost:5432/mydb?schema=public\" npx prisma migrate reset --schema=./src/prisma/schema.prisma",
	"db:adjust": "DATABASE_URL=\"postgresql://GoodCorner:$(cat ../.secrets/password.txt)@localhost:5432/mydb?schema=public\" npx prisma db push --schema=./src/prisma/schema.prisma",
	"db:generate": "DATABASE_URL=\"postgresql://GoodCorner:$(cat ../.secrets/password.txt)@localhost:5432/mydb?schema=public\" npx prisma generate --schema=./src/prisma/schema.prisma",
    "db:populate": "DATABASE_URL=\"postgresql://GoodCorner:$(cat ../.secrets/password.txt)@localhost:5432/mydb?schema=public\" tsx src/prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "concurrently": "^10.0.4",
    "prisma": "^6.19.3",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  }
}
